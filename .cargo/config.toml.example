# Local co-development override for the egui_mobius framework crates.
#
# CopperForge depends on `egui_citizen` / `egui_mobius_reactive` as git
# dependencies pinned to a tag (see Cargo.toml) so a plain `cargo run`
# works on a fresh clone with nothing else checked out.
#
# If you are also hacking on the egui_mobius monorepo itself, copy this
# file to `.cargo/config.toml` (which is gitignored) and adjust the path.
# Cargo's `paths` override then uses your working-tree monorepo instead
# of the pinned git checkout — local edits are picked up with no commit,
# push, or tag bump. Delete `.cargo/config.toml` to go back to the git dep.
#
#   cp .cargo/config.toml.example .cargo/config.toml

paths = ["../egui_mobius"]

# WASM browser build (Phase A of develop/wasm-demo-plan.md).
# getrandom 0.3 refuses to compile for wasm32-unknown-unknown without
# this cfg explicitly opting into the browser RNG backend. Required
# for any `cargo check / build --target wasm32-unknown-unknown` pass.
# See https://docs.rs/getrandom/0.3.3/#webassembly-support
[target.wasm32-unknown-unknown]
rustflags = ['--cfg', 'getrandom_backend="wasm_js"']
